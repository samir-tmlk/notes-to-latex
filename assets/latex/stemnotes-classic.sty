%% stemnotes-classic.sty — "Classic": AMS journal / arXiv preprint look.
%% Latin Modern (Computer Modern), centred small-caps sections, sober amsthm
%% theorems, no ornaments. Loaded by stemnotes.sty; do not load directly.
\ProvidesPackage{stemnotes-classic}[2026/10/16 v1.0 classic style]

%% fonts
\ifsn@unicode
  \RequirePackage{unicode-math}% fontspec's default text font is Latin Modern (with small caps)
  \setmathfont{Latin Modern Math}
\fi

%% page
\RequirePackage[a4paper,textwidth=140mm,headheight=14pt,top=30mm,bottom=32mm,headsep=9mm,footskip=13mm]{geometry}
\setlength{\parindent}{1.5em}

%% colours: almost monochrome, dark navy links as in arXiv preprints
\definecolor{sn@accent}{HTML}{1F2F4F}
\definecolor{sn@link}{HTML}{1F3A68}

%% headings (titlesec), running heads (fancyhdr), equations numbered within sections
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\numberwithin{equation}{section}

\titleformat{\section}{\normalfont\large\scshape\filcenter}{\thesection.}{.5em}{}
\titleformat{\subsection}{\normalfont\bfseries}{\thesubsection.}{.5em}{}
\titleformat{\subsubsection}[runin]{\normalfont\itshape}{\thesubsubsection.}{.4em}{}[.]
\titlespacing*{\section}{0pt}{3.2ex plus 1ex minus .2ex}{1.8ex plus .2ex}
\titlespacing*{\subsection}{0pt}{2.6ex plus .8ex minus .2ex}{1ex plus .2ex}
\titlespacing*{\subsubsection}{\parindent}{1.6ex plus .5ex minus .2ex}{.5em}

%% running heads
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\footnotesize\scshape\sn@runtitle}
\fancyfoot[C]{\small\thepage}
\renewcommand\headrulewidth{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand\headrulewidth{0pt}}

%% captions
\captionsetup{font=small,labelfont=sc,labelsep=period,margin=1em}

%% theorem styles (AMS)
\newtheoremstyle{snplain}{\topsep}{\topsep}{\itshape}{}{\bfseries}{.}{.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \normalfont(#3)}}
\newtheoremstyle{sndefinition}{\topsep}{\topsep}{\normalfont}{}{\bfseries}{.}{.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \normalfont(#3)}}
\newtheoremstyle{snremark}{.6\topsep}{.6\topsep}{\normalfont}{}{\itshape}{.}{.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

%% title
\renewcommand\maketitle{%
  \begingroup\centering
  {\Large\scshape\@title\par}%
  \ifx\sn@subtitle\@empty\else\vspace{.8ex}{\large\itshape\sn@subtitle\par}\fi
  \vspace{2ex}{\normalsize\begin{tabular}[t]{c}\@author\end{tabular}\par}%
  \vspace{.8ex}{\small\@date\par}%
  \ifx\sn@basedon\@empty\else
    \vspace{1.2ex}{\footnotesize\itshape\sn@basedonlabel\ \sn@basedon\par}\fi
  \vspace{4ex}\endgroup
  \thispagestyle{plain}}

\endinput
