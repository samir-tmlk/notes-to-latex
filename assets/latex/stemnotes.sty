\ifsn@unicode\newcommand\mat[1]{\symbfup{#1}}\else\newcommand\mat[1]{\mathbf{#1}}\fi
\providecommand\vv[1]{\overrightarrow{#1}}
% vector calculus: French or English convention
\ifsn@french
  \newcommand\grad{\overrightarrow{\operatorname{grad}}\,}
  \newcommand\divg{\operatorname{div}}
  \newcommand\rot{\overrightarrow{\operatorname{rot}}\,}
  \newcommand\lapl{\Delta}
\else
  \newcommand\grad{\nabla}
  \newcommand\divg{\nabla\cdot}
  \newcommand\rot{\nabla\times}
  \newcommand\lapl{\nabla^2}
\fi
