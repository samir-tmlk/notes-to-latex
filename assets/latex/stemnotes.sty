%% ---------------------------------------------------------------- fidelity markers
%% draft: every departure from the source is visible, with a legend under the title.
%% final: allowed only once everything is resolved. An unresolved \illegible, \missing,
%%        \suspect or \ambiguous is an error; only `added` blocks stay visible.
\definecolor{sn@suspect}{HTML}{B91C1C}  % suspected error in the source
\definecolor{sn@amb}{HTML}{0369A1}      % notation to confirm
\newcount\sn@nopen
\newcommand\sn@unresolved[1]{%
  \ifmeasuring@\else % amsmath typesets align & co. twice: count the final pass only
    \global\advance\sn@nopen\@ne
    \ifsn@draft\else
      \PackageError{stemnotes}{Unresolved \@backslashchar#1 in mode=final}%
        {Resolve it with the user (verify_fidelity.py lists it), or go back to mode=draft.}%
    \fi
  \fi}
\newcommand\sn@mark[3]{% colour, content, sign
  % The sign is bracketed and in sans serif so it cannot be read as mathematics
  % (a bare ! after an exponent would look like a factorial); in maths the
  % marked span is also underlined to show its exact extent.
  \ifmmode{\color{#1}\underline{#2}}^{\text{\normalfont\sffamily\tiny[#3]}}%
  \else{\color{#1}#2\textsuperscript{\normalfont\sffamily[#3]}}\fi}
% Source anchor: shown in draft, hidden in final.
\newcommand\src[1]{%
  \ifsn@draft
    \ifmmode\text{\sn@srctag{#1}}\else\leavevmode\sn@srctag{#1}\fi
  \else
    % final: still release a pending theorem head, so a list that follows
    % starts on its own line exactly as in draft
    \if@inlabel\leavevmode\fi
  \fi\ignorespaces}
\newcommand\sn@srctag[1]{{\normalfont\sffamily\scriptsize\color{sn@muted}\,[#1]\,}}
% The optional first argument of the four open marks locates the passage on the
% source image, for the answer sheet's crops: [p02@x0,y0,x1,y1] in fractions of the
% page image (0,0 = top left), or [p02] for the whole page. It is never typeset.
% Uncertain reading.            \illegible[region]{best reading}
\newcommand\illegible[2][]{\sn@unresolved{illegible}%
  \ifsn@draft\sn@mark{sn@warn}{#2}{?}\else#2\fi}
% Suspected error in the source, typeset AS IN THE SOURCE.   \suspect[region]{as written}{evidence}
\newcommand\suspect[3][]{\sn@unresolved{suspect}%
  \ifsn@draft\sn@mark{sn@suspect}{#2}{!}\else#2\fi}
% Notation whose meaning or convention must be confirmed.    \ambiguous[region]{as written}{question}
\newcommand\ambiguous[3][]{\sn@unresolved{ambiguous}%
  \ifsn@draft\sn@mark{sn@amb}{#2}{n?}\else#2\fi}
% Unreadable, cut or absent passage.   \missing[region]{what is missing}
\newcommand\missing[2][]{\sn@unresolved{missing}%
  \ifsn@draft\ifmmode\text{\sn@missingtag{#2}}\else\sn@missingtag{#2}\fi\fi}
% Resolved by the user WITHOUT certainty (answer "I don't know", option a or b).
% They do not block final; the report lists them.
% \accepted{reading}: best reading accepted by the user; plain in final, tagged in draft.
\newcommand\accepted[1]{\ifsn@draft\sn@mark{sn@muted}{#1}{acc.}\else#1\fi}
% \omitted{what}: unresolved passage the user chose to omit; nothing in final.
\newcommand\omitted[1]{\ifsn@draft
  \ifmmode\text{\sn@omittedtag}\else\leavevmode\sn@omittedtag\fi\fi\ignorespaces}
\newcommand\sn@omittedtag{{\normalfont\sffamily\scriptsize\color{sn@muted}[\sn@name{omis}{omitted}]}}
\newcommand\sn@missingtag[1]{{\normalfont\sffamily\footnotesize\color{sn@warn}%
  [\sn@name{passage illisible~:}{illegible passage:} #1]}}
% Approved correction: highlighted in draft, plain in final.  \fixed{original}{corrected}
\newcommand\fixed[2]{\ifsn@draft{\color{sn@fix}#2}\else#2\fi}
% Crossed-out text in the source: never typeset, tagged in draft, listed in the report.
\newcommand\struck[1]{\ifsn@draft
  \ifmmode\text{\sn@struckttag}\else\leavevmode\sn@struckttag\fi\fi\ignorespaces}
\newcommand\sn@struckttag{{\normalfont\sffamily\scriptsize\color{sn@muted}[\sn@name{barré}{struck out}]}}
% Content that is NOT in the source: visibly marked in every mode.
\tcbset{sn@added/.style={enhanced,breakable,blanker,
  borderline west={1.2pt}{0pt}{sn@added},left=10pt,
  before skip=.8\baselineskip,after skip=.8\baselineskip,
  before upper={\noindent{\sffamily\scriptsize\bfseries\color{sn@added}%
    \sn@name{COMPLÉMENT --- absent du support original}{ADDED --- not in the source}}\par\smallskip}}}
\newenvironment{added}{\begin{tcolorbox}[sn@added]}{\end{tcolorbox}}
% Legend under the title, draft only.
\newcommand\sn@draftlegend{%
  \ifsn@draft\par\begingroup\centering\sffamily\scriptsize\color{sn@muted}%
    \sn@name{BROUILLON. Marques~:}{DRAFT. Marks:}
    [p03]~\sn@name{page source}{source page} \textperiodcentered\
    \textcolor{sn@warn}{x\textsuperscript{[?]}}~\sn@name{lecture incertaine}{uncertain reading} \textperiodcentered\
    \textcolor{sn@suspect}{x\textsuperscript{[!]}}~\sn@name{erreur suspectée dans la source}{suspected error in the source} \textperiodcentered\
    \textcolor{sn@amb}{x\textsuperscript{[n?]}}~\sn@name{notation à confirmer}{notation to confirm} \textperiodcentered\
    \textcolor{sn@warn}{[\dots]}~\sn@name{passage manquant}{missing passage} \textperiodcentered\
    \textcolor{sn@fix}{x}~\sn@name{correction approuvée}{approved correction} \textperiodcentered\
    [\sn@name{barré}{struck out}]~\sn@name{texte barré omis}{crossed-out text omitted} \textperiodcentered\
    x\textsuperscript{[acc.]}~\sn@name{lecture acceptée sans certitude}{reading accepted without certainty} \textperiodcentered\
    [\sn@name{omis}{omitted}]~\sn@name{passage non résolu omis}{unresolved passage omitted}\par
  \endgroup\bigskip\fi}
\AtBeginDocument{\apptocmd{\maketitle}{\sn@draftlegend}{}{}}
\AtEndDocument{%
  \ifnum\sn@nopen>\z@
    \PackageWarningNoLine{stemnotes}{\the\sn@nopen\space open marker(s), see verify_fidelity.py}\fi}

