\DeclareBoolOption[true]{theorems}     % false: declare no block environment (the class provides them)
\DeclareStringOption[french]{lang}     % french | english
\DeclareStringOption[arrow]{vectors}   % arrow | bold
\DeclareStringOption[draft]{mode}      % draft | final
\ProcessKeyvalOptions*

