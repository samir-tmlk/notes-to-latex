%% stemnotes.sty — shared core for STEM course notes
%% One semantic API (environments, notation macros, fidelity markers),
%% three interchangeable looks: style=classic | tufte | boxed.
%% Works with LuaLaTeX (recommended), XeLaTeX and pdfLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{stemnotes}[2026/10/16 v1.0 STEM course notes core]

