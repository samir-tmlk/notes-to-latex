%% ---------------------------------------------------------------- code and algorithms
\lstdefinestyle{stemnotes}{
  basicstyle=\ttfamily\small, columns=fullflexible, keepspaces=true,
  breaklines=true, upquote=true, showstringspaces=false, tabsize=4,
  numbers=left, numberstyle=\scriptsize\color{sn@muted}, numbersep=8pt,
  keywordstyle=\color{sn@accent}\bfseries, commentstyle=\color{sn@muted}\itshape,
  stringstyle=\color{sn@string}, extendedchars=true,
  literate={é}{{\'e}}1 {è}{{\`e}}1 {ê}{{\^e}}1 {à}{{\`a}}1 {â}{{\^a}}1
           {ç}{{\c c}}1 {ù}{{\`u}}1 {û}{{\^u}}1 {ô}{{\^o}}1 {î}{{\^i}}1
           {ï}{{\"i}}1 {ë}{{\"e}}1 {É}{{\'E}}1 {À}{{\`A}}1
}
\lstset{style=stemnotes}
\ifsn@french
  \floatname{algorithm}{Algorithme}
  \renewcommand\lstlistingname{Code}
  \algrenewcommand\algorithmicrequire{\textbf{Entrée~:}}
  \algrenewcommand\algorithmicensure{\textbf{Sortie~:}}
  \algrenewcommand\algorithmicif{\textbf{si}}
  \algrenewcommand\algorithmicthen{\textbf{alors}}
  \algrenewcommand\algorithmicelse{\textbf{sinon}}
  \algrenewcommand\algorithmicfor{\textbf{pour}}
  \algrenewcommand\algorithmicforall{\textbf{pour tout}}
  \algrenewcommand\algorithmicwhile{\textbf{tant que}}
  \algrenewcommand\algorithmicdo{\textbf{faire}}
  \algrenewcommand\algorithmicrepeat{\textbf{répéter}}
  \algrenewcommand\algorithmicuntil{\textbf{jusqu'à}}
  \algrenewcommand\algorithmicreturn{\textbf{renvoyer}}
  \algrenewcommand\algorithmicfunction{\textbf{fonction}}
  \algrenewcommand\algorithmicprocedure{\textbf{procédure}}
