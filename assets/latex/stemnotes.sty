%% ---------------------------------------------------------------- theorem-like environments
%% Every style must define the theorem styles snplain, sndefinition, snremark.
%% All numbered environments share one counter, numbered within sections.
%% An environment the class already defines is kept as it is (imposed templates);
%% with theorems=false none is declared.
\newcommand\sn@thm[3]{% name, shared counter, printed name
  \ifcsundef{#1}{\newtheorem{#1}[#2]{#3}}{\PackageInfo{stemnotes}{keeping the class's `#1'}}}
\ifsn@theorems
  \theoremstyle{snplain}
  \ifcsundef{theorem}{\newtheorem{theorem}{\sn@name{Théorème}{Theorem}}[section]}{}
  \sn@thm{proposition}{theorem}{\sn@name{Proposition}{Proposition}}
  \sn@thm{lemma}{theorem}{\sn@name{Lemme}{Lemma}}
  \sn@thm{corollary}{theorem}{\sn@name{Corollaire}{Corollary}}
  \sn@thm{property}{theorem}{\sn@name{Propriété}{Property}}
  \sn@thm{law}{theorem}{\sn@name{Loi}{Law}}
  \theoremstyle{sndefinition}
  \sn@thm{definition}{theorem}{\sn@name{Définition}{Definition}}
  \sn@thm{example}{theorem}{\sn@name{Exemple}{Example}}
  \sn@thm{exercise}{theorem}{\sn@name{Exercice}{Exercise}}
  \sn@thm{method}{theorem}{\sn@name{Méthode}{Method}}
  \theoremstyle{snremark}
  \sn@thm{remark}{theorem}{\sn@name{Remarque}{Remark}}
  \ifcsundef{notation}{\newtheorem*{notation}{\sn@name{Notation}{Notation}}}{}
\fi
\ifcsundef{solution}{\newenvironment{solution}{\begin{proof}[\sn@name{Solution}{Solution}]}{\end{proof}}}{}

\ifsn@french
  \crefname{theorem}{théorème}{théorèmes}           \Crefname{theorem}{Théorème}{Théorèmes}
  \crefname{proposition}{proposition}{propositions} \Crefname{proposition}{Proposition}{Propositions}
  \crefname{lemma}{lemme}{lemmes}                   \Crefname{lemma}{Lemme}{Lemmes}
  \crefname{corollary}{corollaire}{corollaires}     \Crefname{corollary}{Corollaire}{Corollaires}
  \crefname{property}{propriété}{propriétés}        \Crefname{property}{Propriété}{Propriétés}
  \crefname{law}{loi}{lois}                         \Crefname{law}{Loi}{Lois}
  \crefname{definition}{définition}{définitions}    \Crefname{definition}{Définition}{Définitions}
  \crefname{example}{exemple}{exemples}             \Crefname{example}{Exemple}{Exemples}
  \crefname{exercise}{exercice}{exercices}          \Crefname{exercise}{Exercice}{Exercices}
  \crefname{method}{méthode}{méthodes}              \Crefname{method}{Méthode}{Méthodes}
  \crefname{remark}{remarque}{remarques}            \Crefname{remark}{Remarque}{Remarques}
  \crefname{algorithm}{algorithme}{algorithmes}     \Crefname{algorithm}{Algorithme}{Algorithmes}
  \crefname{figure}{figure}{figures}                \Crefname{figure}{Figure}{Figures}
  \crefname{table}{tableau}{tableaux}               \Crefname{table}{Tableau}{Tableaux}
\else
  \crefname{property}{property}{properties}
  \crefname{law}{law}{laws}
  \crefname{method}{method}{methods}
  \crefname{exercise}{exercise}{exercises}
\fi

