\newcommand\N{\mathbb{N}}
\newcommand\Z{\mathbb{Z}}
\newcommand\Q{\mathbb{Q}}
\newcommand\R{\mathbb{R}}
\newcommand\C{\mathbb{C}}
\newcommand\K{\mathbb{K}}
\newcommand\dd{\mathop{}\!\mathrm{d}}
\newcommand\e{\mathrm{e}}
\newcommand\ii{\mathrm{i}}
\newcommand\jj{\mathrm{j}}
\DeclareRobustCommand\transp{^{\mathsf{T}}}% newtxmath/newpxmath define their own
\newcommand\eqdef{\coloneqq}
\AtBeginDocument{\renewcommand\eqdef{\coloneqq}}% unicode-math would turn it into U+225D
\newcommand\dv[3][]{\frac{\dd^{#1}#2}{\dd #3^{#1}}}
\newcommand\pdv[3][]{\frac{\partial^{#1}#2}{\partial #3^{#1}}}
\DeclarePairedDelimiter\abs{\lvert}{\rvert}
\DeclarePairedDelimiter\norm{\lVert}{\rVert}
\DeclarePairedDelimiter\ceil{\lceil}{\rceil}
\DeclarePairedDelimiter\floor{\lfloor}{\rfloor}
\DeclarePairedDelimiterX\inner[2]{\langle}{\rangle}{#1,#2}
\DeclarePairedDelimiterX\set[1]{\{}{\}}{#1}
% intervals: French ]a,b[ or English (a,b)
\newcommand\icc[2]{\mathopen{[}#1\mathpunct{,}#2\mathclose{]}}
\newcommand\ioo[2]{\ifsn@french\mathopen{]}#1\mathpunct{,}#2\mathclose{[}\else\mathopen{(}#1\mathpunct{,}#2\mathclose{)}\fi}
\newcommand\ico[2]{\ifsn@french\mathopen{[}#1\mathpunct{,}#2\mathclose{[}\else\mathopen{[}#1\mathpunct{,}#2\mathclose{)}\fi}
\newcommand\ioc[2]{\ifsn@french\mathopen{]}#1\mathpunct{,}#2\mathclose{]}\else\mathopen{(}#1\mathpunct{,}#2\mathclose{]}\fi}
\ifsn@unicode
  \newcommand\intint[2]{\mathopen{\lBrack}#1\mathpunct{,}#2\mathclose{\rBrack}}
\else
  \newcommand\intint[2]{\mathopen{\llbracket}#1\mathpunct{,}#2\mathclose{\rrbracket}}
\fi
% vectors and matrices
\ifdefstring{\sn@vectors}{bold}
